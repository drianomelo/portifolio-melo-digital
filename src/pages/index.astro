---
import '../styles/global.css';
import { projects, site } from '../data/site';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f3eee4" />
    <meta name="description" content={site.description} />
    <link rel="canonical" href="https://melodigital.com.br/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{site.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="#inicio" aria-label="Melo Digital, voltar ao início">
          <span class="brand-mark" aria-hidden="true">M</span><span>Melo Digital</span>
        </a>
        <nav aria-label="Navegação principal">
          <a href="#trabalhos">Trabalhos</a>
          <a href="#sobre">Sobre</a>
          <a class="nav-contact" href={site.githubUrl} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <main id="conteudo">
        <section class="hero" id="inicio" aria-labelledby="hero-title">
          <div class="hero-copy">
            <h1 id="hero-title">{site.headline}</h1>
            <p class="hero-intro">{site.introduction}</p>
            <a class="text-link" href="#trabalhos">Explorar trabalhos <span aria-hidden="true">↗</span></a>
          </div>
          <div class="hero-art" aria-hidden="true"><div class="art-ring art-ring-one"></div><div class="art-ring art-ring-two"></div><div class="art-center">m<span>.</span></div></div>
        </section>
        <section class="work-section" id="trabalhos" aria-labelledby="work-title">
          <div class="section-heading"><h2 id="work-title">Trabalhos</h2><p>Projetos, escolhas e resultados.</p></div>
          {projects.length > 0 ? (
            <div class="project-grid">
              {projects.map((project) => (
                <article class="project">
                  {project.image && <img src={project.image} alt="" loading="lazy" />}
                  <div class="project-info">
                    <span class="project-category">{project.category}</span>
                    <h3>{project.title}</h3>
                    <p>{project.description}</p>
                    <a href={project.url} target="_blank" rel="noopener noreferrer">Ver projeto <span aria-hidden="true">↗</span></a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <div class="empty-work"><span class="empty-symbol" aria-hidden="true">✳</span><p>Novos projetos serão apresentados aqui em breve.</p></div>
          )}
        </section>
        <section class="about-section" id="sobre" aria-labelledby="about-title">
          <h2 id="about-title">Sobre a Melo Digital</h2>
          <p>{site.about}</p>
          <a class="text-link" href={site.githubUrl} target="_blank" rel="noopener noreferrer">Acompanhe no GitHub <span aria-hidden="true">↗</span></a>
        </section>
      </main>
      <footer class="site-footer"><span>© {year} Melo Digital</span><a href="#inicio">Voltar ao início ↑</a></footer>
    </div>
  </body>
</html>
